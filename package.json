{
  "name": "asian-home-fidelite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "build:api": "tsc -p . && vite build --mode api",
    "preview": "vite preview",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test": "npm run typecheck:server && node --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "seed": "node scripts/generer-seed.mjs",
    "serveur": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "jsqr": "1.4.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
